{
  "name": "@local/dsh-jevharness-preset",
  "version": "2.2.6",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "jev-harness-loop",
    "jev-decide-tool",
    "shared"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "bench": "node bench/suite.mjs",
    "report": "node scripts/jev-report.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
